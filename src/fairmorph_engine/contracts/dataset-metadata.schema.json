{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fairmorph.org/contracts/poc/1/dataset-metadata.schema.json",
  "title": "Versioned dataset title project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "parent_revision_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "fairmorph.dataset-metadata/1"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "parent_revision_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  }
}
