{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fairmorph.org/contracts/poc/1/dataset-metadata-approval.schema.json",
  "title": "Explicit project file approval of an immutable dataset title",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_sha256",
    "decision",
    "confirmed_by"
  ],
  "properties": {
    "schema_version": {
      "const": "fairmorph.dataset-metadata-approval/1"
    },
    "revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "const": "approve"
    },
    "confirmed_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
