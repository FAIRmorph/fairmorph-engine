{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fairmorph.org/contracts/poc/2/publication-integrity.schema.json",
  "title": "External integrity constraints for projected RUN tables",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_manifest_sha256",
    "identifiers",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "fairmorph.poc.publication-integrity/1"
    },
    "run_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_type",
          "column"
        ],
        "properties": {
          "row_type": {
            "enum": [
              "Event",
              "Occurrence"
            ]
          },
          "column": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "child_row_type",
          "child_column",
          "parent_row_type",
          "parent_column"
        ],
        "properties": {
          "child_row_type": {
            "enum": [
              "Event",
              "Occurrence"
            ]
          },
          "child_column": {
            "type": "string",
            "minLength": 1
          },
          "parent_row_type": {
            "enum": [
              "Event",
              "Occurrence"
            ]
          },
          "parent_column": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
