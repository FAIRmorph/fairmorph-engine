{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fairmorph.org/contracts/poc/1/package-registration.schema.json",
  "title": "Project-local draft for registering a virtual FAIRmorph package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "fairmorph.poc.package-registration/1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "resource_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
