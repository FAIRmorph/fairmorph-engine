{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fairmorph.org/contracts/poc/1/export.schema.json",
  "title": "FAIRmorph PoC independently versioned export manifest",
  "type": "object",
  "required": ["schema_version", "export_id", "source_run_id", "profile_id", "profile_version", "created_at", "source_run_manifest_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": "fairmorph.poc.export/1"},
    "export_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "profile_id": {"enum": ["frictionless-data-package", "darwin-core-archive-event-occurrence"]},
    "profile_version": {"enum": ["poc/1", "cs-phoc-published/1"]},
    "created_at": {"type": "string", "format": "date-time"},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^package/[a-z0-9_.-]+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
