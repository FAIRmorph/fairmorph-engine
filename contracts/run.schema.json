{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fairmorph.org/contracts/poc/1/run.schema.json",
  "title": "FAIRmorph PoC immutable run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "started_at", "engine_version", "transformation_version", "configuration_sha256", "input_snapshot_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": "fairmorph.poc.run/1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"const": "completed"},
    "started_at": {"type": "string", "format": "date-time"},
    "engine_version": {"type": "string", "minLength": 1},
    "transformation_version": {"const": "cs-phoc-unpivot/1"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "input_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1, "pattern": "^(outputs|audit|reports)/|^(inputs|configuration)\\.snapshot\\.json$"},
      "bytes": {"type": "integer", "minimum": 0},
      "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
